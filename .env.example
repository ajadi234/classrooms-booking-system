# Copy this file's contents into Render's Environment tab (or a local .env
# if you use python-dotenv for local dev). Never commit real secrets to Git.

# A long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Provided automatically by Render once you attach a PostgreSQL database
# to this web service — you normally don't need to set this by hand.
DATABASE_URL=

# Gmail address used to send password-reset emails (must have an App
# Password set up, not your normal Gmail password).
MAIL_USERNAME=
MAIL_PASSWORD=

# Password for the auto-created admin@school.com account, set on first run.
ADMIN_PASSWORD=
